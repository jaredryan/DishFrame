# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Database ------------------------------------------------------------
# Which Prisma driver adapter to use — see src/lib/db/adapter.ts.
# "pg":   ordinary local development and CI, against a disposable plain
#         Postgres (see docker-compose.yml and `pnpm db:docker:up` /
#         `pnpm db:migrate:local`). This is what .env.local should use.
# "neon": deployed environments, against Neon (default; safe to leave unset
#         in production — Vercel's own env vars already set this).
# Deliberately explicit rather than inferred from DATABASE_URL's shape.
DATABASE_DRIVER="pg"

# --- Option A: local Docker Postgres (ordinary local development) -------
# Matches docker-compose.yml exactly. Start it with `pnpm db:docker:up`,
# then `pnpm db:migrate:local` once. DIRECT_URL must point at a *separate*
# shadow database (never the same as DATABASE_URL) — required by
# `prisma migrate dev` for its diffing. docker-compose.yml creates both
# databases in the same container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dishframe"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/dishframe_shadow"

# --- Option B: deployed Neon (production/preview only) -------------------
# Never used by ordinary local development. Vercel's own environment
# variables already provide these in deployed environments — you should not
# normally need to set them locally at all.
# DATABASE_DRIVER="neon"
# DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/dishframe?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dishframe?sslmode=require"

# --- Option C: guarded local access to PRODUCTION Neon (rare) -------------
# For the rare case of intentionally running the local app against the real
# production database. Put the Option B values above (with your real Neon
# credentials) into a separate, git-ignored .env.production-access.local
# file instead of here, then run:
#   CONFIRM_PRODUCTION_DATABASE=yes pnpm dev:production-db
# See scripts/dev-production-db.mjs. This path is for `pnpm dev` only —
# never for tests, seeds, resets, or migration development, all of which
# must refuse to run unless DATABASE_DRIVER=pg.

# --- Better Auth --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Contact form (Resend) --------------------------------------------
# Resend dashboard > API Keys.
RESEND_API_KEY=""
# onboarding@resend.dev works without a verified domain, but can only
# deliver to the Resend account owner's own email — see README.
CONTACT_FROM_EMAIL="DishFrame <onboarding@resend.dev>"
# Where contact-form notifications are sent.
CONTACT_TO_EMAIL=""

# --- USDA FoodData Central API key to retrieve nutrition data ---------
FDC_API_KEY=""
