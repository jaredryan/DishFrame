# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# --- Database (Neon Postgres) -----------------------------------------
# Pooled connection string, used by the app at runtime.
# In the Neon console: Connect > Pooled connection.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/dishframe?sslmode=require"

# Direct (unpooled) connection string, used for migrations.
# In the Neon console: Connect > Direct connection.
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/dishframe?sslmode=require"

# --- Better Auth --------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Contact form (Resend) --------------------------------------------
# Resend dashboard > API Keys.
RESEND_API_KEY=""
# onboarding@resend.dev works without a verified domain, but can only
# deliver to the Resend account owner's own email — see README.
CONTACT_FROM_EMAIL="DishFrame <onboarding@resend.dev>"
# Where contact-form notifications are sent.
CONTACT_TO_EMAIL=""
